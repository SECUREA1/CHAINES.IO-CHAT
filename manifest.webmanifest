{
  "id": "/",
  "name": "CHAINeS POST",
  "short_name": "CHAINeS",
  "description": "The full CHAINeS POST app: custom panels, community feed, live broadcasting, wallets, marketplace, OMConsole, and AR collectibles.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#091427",
  "theme_color": "#091427",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "social",
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/static/brand/v2/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/static/brand/v2/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/brand/v2/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/brand/v2/logo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open marketplace",
      "short_name": "Marketplace",
      "url": "/marketplace.html",
      "icons": [
        {
          "src": "/static/brand/v2/logo.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "/static/brand/v2/logo-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My profile",
      "short_name": "Profile",
      "url": "/profile.html",
      "icons": [
        {
          "src": "/static/brand/v2/logo.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        },
        {
          "src": "/static/brand/v2/logo-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "OMConsole",
      "url": "/omconsole_render_single.html",
      "icons": [
        {
          "src": "/static/brand/v2/logo-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "AR Collectibles",
      "url": "/chaines-ar-collectibles.html",
      "icons": [
        {
          "src": "/static/brand/v2/logo-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "screenshots": [
    {
      "src": "/static/brand/v2/app-preview-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "CHAINeS POST full app with the new branding"
    },
    {
      "src": "/static/brand/v2/app-preview-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "CHAINeS POST mobile account and guest entry"
    }
  ]
}
