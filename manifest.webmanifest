{
  "id": "/",
  "name": "CHAINeS Post & Media Studio Network",
  "short_name": "CHAINeS Studio",
  "description": "Create boldly. Publish brilliantly. Connect without limits. An all-in-one network for multimedia posts, live streams, social commerce, and secure communities.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "handle_links": "preferred",
  "background_color": "#06265d",
  "theme_color": "#0756b7",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "social",
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/static/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open marketplace",
      "short_name": "Marketplace",
      "url": "/marketplace.html",
      "icons": [
        {
          "src": "/static/marketplace.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "My profile",
      "short_name": "Profile",
      "url": "/profile.html",
      "icons": [
        {
          "src": "/static/user.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
