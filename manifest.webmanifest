{
  "id": "/",
  "name": "CHAINeS POST",
  "short_name": "CHAINeS",
  "description": "Create, share, stream, and discover in the CHAINeS community.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#091427",
  "theme_color": "#091427",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "social",
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/static/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/logo-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Open marketplace",
      "short_name": "Marketplace",
      "url": "/marketplace.html",
      "icons": [
        {
          "src": "/static/marketplace.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "My profile",
      "short_name": "Profile",
      "url": "/profile.html",
      "icons": [
        {
          "src": "/static/user.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
